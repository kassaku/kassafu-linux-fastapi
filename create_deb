#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"
PKG="kassafu"
BUILD_DIR="$(mktemp -d)"
trap 'rm -rf "$BUILD_DIR"' EXIT

PKG_ROOT="$BUILD_DIR/$PKG"
ROOT="$PKG_ROOT/usr/share/kassafu"
mkdir -p "$ROOT" "$PKG_ROOT/DEBIAN"

cp kassafu.py mypos_terminal.py mypos_gateway.py sumup_terminal.py ccv.py "$ROOT/"
cp test_reader_status_sumup.py test_reader_status_mypos.py test_real_payment.py "$ROOT/"
cp requirements.txt install.sh "$ROOT/"

for f in kassafu.py mypos_terminal.py mypos_gateway.py sumup_terminal.py ccv.py install.sh; do
    chmod 755 "$ROOT/$f"
done

cat > "$PKG_ROOT/DEBIAN/control" <<EOF
Package: $PKG
Version: $VERSION
Section: misc
Priority: optional
Architecture: all
Maintainer: Houkes Horeca Applications
Depends: python3, python3-venv, python3-pip
Description: KassaFu payment bridge between POS and payment terminals
 SumUp / myPOS terminal bridge exposing a REST API.
EOF

cat > "$PKG_ROOT/DEBIAN/postinst" <<'EOF'
#!/bin/sh
set -e
APP=/usr/share/kassafu
chown -R "${SUDO_USER:-$USER}" "$APP" 2>/dev/null || true
bash "$APP/install.sh"
EOF

cat > "$PKG_ROOT/DEBIAN/prerm" <<'EOF'
#!/bin/sh
set -e
systemctl stop kassafu || true
EOF

cat > "$PKG_ROOT/DEBIAN/postrm" <<'EOF'
#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
    systemctl disable kassafu || true
    rm -f /etc/systemd/system/kassafu.service
    systemctl daemon-reload || true
    rm -rf /usr/share/kassafu
fi
EOF

chmod 755 "$PKG_ROOT/DEBIAN/postinst" "$PKG_ROOT/DEBIAN/prerm" "$PKG_ROOT/DEBIAN/postrm"

dpkg-deb --build --root-owner-group "$PKG_ROOT" "$PKG.deb"
echo "Built $PKG.deb"